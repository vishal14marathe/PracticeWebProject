@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<section class="page-hero">

   
    <p class="page-hero-label">
        WHO WE ARE
    </p>

    <h1 class="page-hero-title">
        About <span>Us</span>
    </h1>

    <p class="page-hero-description">
        Learn more about our company and what we do.
    </p>
    

</section>

<section class="about-section">

  
    <div class="about-content">

        <p class="about-label">
            ABOUT OUR COMPANY
        </p>

        <h2 class="about-title">
            We Build <span>Digital Solutions</span>
        </h2>

        <p class="about-description">
            We are a technology-focused company that creates
            modern websites, web applications and APIs.
        </p>

        <p class="about-description">
            Our goal is to build simple, reliable and
            user-friendly digital solutions for businesses
            and individuals.
        </p>

        <p class="about-description">
            We believe in learning new technologies, solving
            real-world problems and continuously improving our skills.
        </p>

        <a href="/guest/contactus" class="about-button">
            Get In Touch
        </a>

    </div>


    <div class="about-stats">

        <div class="about-stat-card">
            <strong>5+</strong>
            <span>Projects</span>
        </div>

        <div class="about-stat-card">
            <strong>3+</strong>
            <span>Technologies</span>
        </div>

        <div class="about-stat-card">
            <strong>100%</strong>
            <span>Dedication</span>
        </div>

    </div>
    

</section>

<section class="about-values">
 
    <div class="about-values-container">

        <div class="about-values-heading">

            <p class="about-values-label">
                OUR VALUES
            </p>

            <h2 class="about-values-title">
                Why <span>Choose Us?</span>
            </h2>

        </div>


        <div class="about-values-grid">

            <div class="about-value-card">

                <div class="about-value-icon">
                    🎯
                </div>

                <h3>Quality</h3>

                <p>
                    We focus on writing clean and maintainable code.
                </p>

            </div>


            <div class="about-value-card">

                <div class="about-value-icon">
                    💡
                </div>

                <h3>Innovation</h3>

                <p>
                    We continuously learn and use modern technologies.
                </p>

            </div>


            <div class="about-value-card">

                <div class="about-value-icon">
                    🤝
                </div>

                <h3>Support</h3>

                <p>
                    We believe in communication and long-term relationships.
                </p>

            </div>

        </div>

    </div>
   

</section>
