@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}



<section class="bg-light py-5">

    <div class="container py-5">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <p class="text-primary fw-bold mb-3">
                    WELCOME TO OUR WEBSITE
                </p>

                <h1 class="display-3 fw-bold text-dark mb-4">
                    Build Your
                    <span class="text-primary">
                        Digital Future
                    </span>
                </h1>

                <p class="lead text-secondary mb-4">
                    We create modern, responsive and user-friendly
                    websites and applications using modern technologies.
                </p>

                <div class="d-flex gap-3">

                    <a href="/guest/services"
                       class="btn btn-primary btn-lg">
                        Our Services
                    </a>

                    <a href="/guest/contactus"
                       class="btn btn-outline-primary btn-lg">
                        Contact Us
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     SERVICES SECTION
========================================= -->

<section class="py-5">

    <div class="container py-4">

        <!-- Section Heading -->

        <div class="text-center mb-5">

            <p class="text-primary fw-bold mb-2">
                WHAT WE DO
            </p>

            <h2 class="display-5 fw-bold text-dark">
                Our
                <span class="text-primary">
                    Services
                </span>
            </h2>

            <p class="text-secondary mt-3">
                Explore the technologies and services we work with.
            </p>

        </div>


        <!-- Service Cards -->

        <div class="row g-4">


            <!-- Card 1 -->

            <div class="col-lg-4 col-md-6">

                <div class="card h-100 border-0 shadow-sm text-center">

                    <div class="card-body p-5">

                        <div class="fs-1 mb-3">
                            💻
                        </div>

                        <h3 class="h4 fw-bold mb-3">
                            ASP.NET Core
                        </h3>

                        <p class="text-secondary mb-0">
